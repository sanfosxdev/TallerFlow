# DEMO pública: datos ficticios guardados en este navegador. false para producción.
VITE_DEMO_MODE=true
APP_ORIGIN=https://tu-taller.vercel.app
GAS_URL=https://script.google.com/macros/s/REEMPLAZAR/exec
GAS_SECRET=generar-secreto-de-32-bytes
SESSION_SECRET=otro-secreto-distinto-de-32-bytes
ADMIN_PASSWORD_HASH=salt:hash-generado-con-script
# Protección antispam obligatoria en producción: Cloudflare Turnstile (gratuito)
VITE_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# #23 Observabilidad: umbral (minutos) de antiguedad de LAST_RUN antes de que el ping reporte ok=false. Opcional, default 45.
PING_MAX_MINUTES=45
